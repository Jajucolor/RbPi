{
    "stt": {
        "phrase_time_limit": 5,
        "silence_threshold": 0.01,
        "sample_rate": 16000,
        "model": "whisper-1",
        "language": "en"
    },
    "ai": {
        "provider": "ollama",
        "model": "llama3.2:11b",
        "temperature": 0.4,
        "max_tokens": 256,
        "ollama_host": "http://localhost:8000"
      },      
    "tts": {
        "rate": 200,
        "volume": 0.9,
        "voice_id": null
    },
    "system": {
        "wake_word": "hey assistant",
        "log_responses": true
    },
    "hardware": {
        "camera_enabled": true,
        "sensors_enabled": true,
        "sensor_port": "/dev/ttyACM0",
        "sensor_baudrate": 9600
    }
} 